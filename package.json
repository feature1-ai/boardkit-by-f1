{
  "name": "@feature1/boardkit",
  "version": "0.1.0",
  "description": "The open-source task engine for AI-powered workflow products — boards, lanes, cards, and a typed event stream your automations and agents plug into. Self-hostable Trello alternative included; the vertical value comes from the opinions you build on top.",
  "keywords": [
    "kanban",
    "board",
    "task-engine",
    "workflow",
    "automation",
    "ai",
    "agents",
    "trello",
    "trello-alternative",
    "process"
  ],
  "license": "MIT",
  "author": "Abdul Rahman K",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
